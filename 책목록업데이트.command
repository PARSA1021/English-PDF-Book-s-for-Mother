#!/bin/zsh

# 현재 스크립트가 위치한 디렉토리로 이동
cd "$(dirname "$0")"

echo "----------------------------------------"
echo "📚 엄마의 책장 목록 업데이트를 시작합니다..."
echo "----------------------------------------"

# 파이썬 스크립트 실행
python3 scripts/update_books.py

if [ $? -eq 0 ]; then
    echo "----------------------------------------"
    echo "✅ 업데이트가 성공적으로 완료되었습니다!"
    echo "이제 웹사이트를 새로고침하면 새로운 책이 보입니다."
    echo "----------------------------------------"
else
    echo "----------------------------------------"
    echo "❌ 업데이트 중 오류가 발생했습니다."
    echo "관리자(아들)에게 문의해주세요."
    echo "----------------------------------------"
fi

# 사용자 확인을 위해 잠시 대기
echo "창을 닫으려면 아무 키나 누르세요..."
read -n 1
